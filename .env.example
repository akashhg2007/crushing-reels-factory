# ============================================
# CRUSHING REELS FACTORY — Environment Variables
# ============================================
# Copy this to .env and fill in your values

# Google Gemini API (for Veo 3.1 video generation)
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# YouTube OAuth2 credentials (from Google Cloud Console)
# 1. Go to: https://console.cloud.google.com
# 2. Create project → Enable YouTube Data API v3
# 3. APIs & Services → Credentials → Create OAuth 2.0 Client ID (Desktop type)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/oauth2callback

# Server port (Railway/Sheroku set this automatically)
PORT=3000
